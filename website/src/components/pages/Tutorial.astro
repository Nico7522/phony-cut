---
import Layout from "../../layouts/Layout.astro";
import DownloadButton from "../DownloadButton.astro";
import { assetUrl, pageUrl, t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang).tutorial;

// Screenshots come from ../assets/tutorial/ (copied at build time, see CLAUDE.md).
// They are all 1220 × 2712 phone screenshots.
const SHOT_WIDTH = 1220;
const SHOT_HEIGHT = 2712;
---

<Layout lang={lang} page="tutorial" title={text.title}>
  <div class="container narrow">
    <h1>{text.title}</h1>
    <p set:html={text.intro} />
    <div class="notice">
      <p>{text.variesNotice}</p>
    </div>

    <nav class="steps-nav" aria-label={text.stepsNav}>
      <ol>
        {text.steps.map((step) => <li><a href={`#${step.id}`}>{step.title}</a></li>)}
      </ol>
    </nav>

    {
      text.steps.map((step) => (
        <section class="tutorial-step card" id={step.id} aria-labelledby={`${step.id}-title`}>
          <h2 id={`${step.id}-title`}>{step.title}</h2>
          <p set:html={step.body} />

          {step.brandPaths !== "" && (
            <table>
              <thead>
                <tr>
                  <th scope="col">{text.brandColumn}</th>
                  <th scope="col">{text.pathColumn}</th>
                </tr>
              </thead>
              <tbody>
                {text.brands.map((brand) => (
                  <tr>
                    <th scope="row">{brand.name}</th>
                    <td>{step.brandPaths === "developer" ? brand.developer : brand.usb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          <div class="shots">
            {step.images.map((image) => (
              <figure>
                <img
                  src={assetUrl(`shared/tutorial/${image.file}`)}
                  alt={image.alt}
                  width={SHOT_WIDTH}
                  height={SHOT_HEIGHT}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>

          <details>
            <summary>{text.helpTitle}</summary>
            <ul>
              {step.help.map((tip) => <li>{tip}</li>)}
            </ul>
          </details>
        </section>
      ))
    }

    <section class="tutorial-step card" aria-labelledby="done-title">
      <h2 id="done-title">{text.doneTitle}</h2>
      <p>{text.doneText}</p>
      <p><a href={pageUrl(lang, "faq")}>{text.faqLink} →</a></p>
    </section>

    <DownloadButton lang={lang} />
  </div>
</Layout>
